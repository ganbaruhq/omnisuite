{
  "name": "@omnisuite/ui",
  "version": "0.1.0",
  "description": "shadcn-based React components and theme for Omnisuite.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganbaruhq/omnisuite.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./globals.css": "./dist/styles/globals.css",
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "import": "./dist/lib/*.js"
      },
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "import": "./dist/components/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "import": "./dist/hooks/*.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.52.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "input-otp": "1.5.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
